# PhoneBridge Environment Configuration

# WebSocket Signaling Server Port (Default: 3001)
SIGNALING_PORT=3001
PORT=3001

# Vite Frontend Dev Server Port (Default: 5173)
VITE_PORT=5173

# Optional: Default Signaling URL for Production / Tunnel (e.g. wss://signaling.yourdomain.com)
VITE_SIGNALING_URL=

# Optional: Custom TURN Relay server (for restrictive symmetric NAT firewalls)
# VITE_TURN_URL=turn:turn.yourdomain.com:3478
# VITE_TURN_USER=phonebridge
# VITE_TURN_PASS=your-secure-turn-password
